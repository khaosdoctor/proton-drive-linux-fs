[Unit]
Description=Proton Drive FS (mount + tray)
# The key password lives in the OS keyring, which is only unlockable once the
# graphical session is up; starting earlier exhausts the restart limit.
# "proton-drive-fs autostart -headless" retargets this to default.target.
After=network-online.target graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/proton-drive-fs/session.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# The mount daemon shows a system tray icon automatically when a display server
# is available; pass -no-tray to disable it.
ExecStart=@BINDIR@/proton-drive-fs mount -foreground
ExecStop=@BINDIR@/proton-drive-fs unmount
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
