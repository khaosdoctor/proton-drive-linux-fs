[Unit]
Description=Proton Drive FS (mount + tray)
After=network-online.target
ConditionPathExists=%h/.config/proton-drive-fs/session.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# The mount daemon shows a system tray icon automatically when a display server
# is available; pass -no-tray to disable it.
ExecStart=@BINDIR@/proton-drive-fs mount -foreground
ExecStop=@BINDIR@/proton-drive-fs unmount
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
