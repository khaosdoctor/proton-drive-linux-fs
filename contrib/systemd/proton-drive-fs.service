[Unit]
Description=Proton Drive FUSE mount
After=network-online.target
ConditionPathExists=%h/.config/proton-drive-fs/session.json
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# Takes its mountpoint from `mountpoint` in config.toml; set it with `proton-drive-fs config
# init` and an edit.
ExecStart=@BINDIR@/proton-drive-fs mount -foreground
ExecStop=@BINDIR@/proton-drive-fs unmount
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
