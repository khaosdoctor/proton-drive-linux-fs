FROM alpine:3.22

RUN apk add --no-cache fuse3 ca-certificates
COPY proton-drive-fs /usr/local/bin/

LABEL org.opencontainers.image.source="https://github.com/khaosdoctor/proton-drive-linux-fs"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.description="FUSE virtual filesystem that mounts Proton Drive on Linux with on-demand file download"

ENTRYPOINT ["proton-drive-fs"]
